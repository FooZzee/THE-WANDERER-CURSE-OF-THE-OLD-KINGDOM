; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Wanderer: Curse of the Old Kingdom (Странник: Проклятие Старого Королевства)"
config/description="3D Dark Fantasy Action-RPG in Godot 4.x — Day/Night cycle, dynamic weather, 5 Ash Magic Signs, 12 Quests, 3 Hunter Contracts, and smart NPCs."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
QuestManager="*res://scripts/autoload/quest_manager.gd"
DialogueDatabase="*res://scripts/autoload/dialogue_database.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="player"
3d_physics/layer_2="world"
3d_physics/layer_3="enemies"
3d_physics/layer_4="interactables"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

lights_and_shadows/directional_shadow/size=4096
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.09, 1)
